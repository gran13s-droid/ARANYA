{
  "name": "aranya",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm assets && pnpm -r --parallel --filter ./server --filter ./client dev",
    "build": "pnpm assets && pnpm -r build",
    "assets": "pnpm --filter @aranya/tools build-sprites",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm assets && vitest run --config vitest.e2e.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:all": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@aranya/shared": "workspace:*",
    "@colyseus/sdk": "^0.18.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
